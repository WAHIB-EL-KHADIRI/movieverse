# TMDB v3 API key (the short 32-character hex key, NOT the long "Read Access Token").
# Get one at https://www.themoviedb.org/settings/api
# NOTE: VITE_* variables are bundled into the browser build and are therefore PUBLIC.
# Use a dedicated key for this app; never put a private token here.
VITE_TMDB_API_KEY=your_tmdb_v3_api_key_here
